{
  "expo": {
    "name": "Evenly",
    "slug": "evenly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "evenly",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.evenly.tracker"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0e6650",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.evenly.tracker",
      "permissions": [
        "CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Evenly",
      "shortName": "Evenly",
      "themeColor": "#0e6650",
      "backgroundColor": "#eef3f0"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0e6650",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Evenly uses your photos for receipts, your profile picture and group covers.",
          "cameraPermission": "Evenly uses the camera to photograph receipts and take a profile picture.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0e6650",
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "description": "Split bills with friends: groups, shared expenses, balances and settle-up."
  }
}
